<apex:page standardController="dealer__Service_Repair_Order__c"
           extensions="FormServiceRepairOrderWarrantyCopyExt"
           id="ServiceROWarrantyCopy"
           showHeader="false"
           sidebar="false"
           renderAs="{!renderAs}"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false"
           cache="false">
<head>
<style type="text/css">
    body {
        font-family: Tahoma, Geneva, sans-serif;
        font-size: 12px;
        margin: 0;
        padding: 0;
    }
    td, th {
        font-family: Tahoma, Geneva, sans-serif;
        padding: 5px;
    }
    th {
        text-align: left;
        font-weight: bold;
        white-space: nowrap;
    }
    table {
        width: 100%;
    }

    .cGrey { color: #666; }
    .cGreyI { color: #666; font-style: italic; }
    .bBottom { border-bottom: 1px solid #999; }
    .bTop    { border-top: 1px solid #999; }
    .bLeft   { border-left: 1px solid #999; }
    .bRight  { border-right: 1px solid #999; }

    .headerBlock {
        border: 1px solid #999;
        border-collapse: collapse;
        margin-bottom: 6px;
        table-layout: fixed;
    }
    .headerBlock td, .headerBlock th {
        padding: 3px 6px;
        vertical-align: top;
        font-size: 11px;
    }
    .headerTitle {
        background-color: #f0f0f0;
        font-weight: bold;
        font-size: 18px;
        text-transform: uppercase;
        border-bottom: 1px solid #999;
        padding: 6px;
    }
    .dealerName {
        font-size: 13px;
        font-weight: bold;
    }
    .serviceHours {
        margin-top: 6px;
        font-size: 9px;
        line-height: 1.3;
        color: #333;
    }
    .serviceHoursTitle {
        font-weight: bold;
        color: #666;
        text-transform: uppercase;
        font-size: 9px;
    }
    .locationName {
        font-size: 12px;
        font-weight: bold;
    }
    .sectionHeader {
        background-color: #f0f0f0;
        color: #000;
        padding: 6px;
        font-weight: bold;
        font-size: 13px;
    }
    .infoTable {
        border-collapse: collapse;
        width: 100%;
    }
    .infoTable td {
        border: 1px solid #ccc;
        padding: 3px 6px;
    }
    .infoLabel {
        background-color: #f5f5f5;
        color: #666;
        font-weight: bold;
        white-space: nowrap;
        width: 90px;
    }
    .infoValueBold {
        font-weight: bold;
        font-size: 12px;
    }
    .amountRow td {
        background-color: #666;
        color: #fff;
        font-weight: bold;
    }
    .amountRow td.infoLabel {
        background-color: #666;
        color: #fff;
    }
    .contactLabel {
        color: #666;
        font-weight: bold;
        white-space: nowrap;
        width: 55px;
        border-bottom: 1px solid #ccc;
        border-right: 1px solid #ccc;
        padding: 2px 6px;
    }
    .contactValue {
        border-bottom: 1px solid #ccc;
        padding: 2px 6px;
    }
    .vehicleTable {
        border: none;
    }
    .vehicleTable td {
        font-size: 11px;
    }

    .job-line-block {
        page-break-inside: avoid;
        margin-bottom: 8px;
        border: 1px solid #999;
        border-collapse: collapse;
        table-layout: fixed;
    }
    .job-line-block td, .job-line-block th {
        padding: 3px 6px;
        vertical-align: top;
        font-size: 11px;
    }
    .jobHeader td {
        background-color: #666;
        color: #fff;
        font-weight: bold;
    }
    .jobDescLabel {
        color: #666;
        font-style: italic;
        white-space: nowrap;
    }
    .detailTable {
        border-collapse: collapse;
        width: 100%;
    }
    .detailTable th {
        color: #666;
        font-style: italic;
        font-weight: normal;
        font-size: 10px;
        border-bottom: 1px solid #ccc;
        padding: 2px 4px;
    }
    .detailTable td {
        padding: 2px 4px;
        font-size: 11px;
        border-bottom: 1px solid #eee;
    }
    .alignRight { text-align: right; white-space: nowrap; }
    .alignCenter { text-align: center; }

    .subtotalRow td {
        border-top: 1px solid #ccc;
        text-align: right;
        white-space: nowrap;
    }
    .subtotalLabel {
        text-align: right;
        color: #666;
    }
    .lineTotalRow td {
        background-color: #eee;
        font-weight: bold;
        text-align: right;
        white-space: nowrap;
        border-top: 1px solid #999;
    }
    .colHeadRow td {
        color: #666;
        font-style: italic;
        font-size: 10px;
        text-align: right;
        border-bottom: 1px solid #ccc;
    }

    .summaryWrapper {
        margin-top: 14px;
        page-break-inside: avoid;
    }
    .disclaimerCell {
        font-size: 9px;
        color: #666;
        vertical-align: top;
        line-height: 1.3;
        padding-right: 12px;
    }
    .noticeBar {
        background-color: #666;
        color: #fff;
        font-size: 9px;
        font-weight: bold;
        padding: 3px 6px;
        margin-top: 4px;
    }
    .signatureLine {
        margin-top: 24px;
        vertical-align: bottom;
    }
    .bigX { font-size: 22px; }

    .totalsTable {
        table-layout: fixed;
        width: 100%;
        border-collapse: collapse;
    }
    .totalsTable td {
        border: 1px solid #ccc;
        padding: 4px 6px;
    }
    .totalsLabel {
        white-space: nowrap;
        width: 60%;
        color: #666;
        font-weight: bold;
        background-color: #f5f5f5;
    }
    .totalsValue {
        text-align: right;
        white-space: nowrap;
        width: 40%;
    }
    .grandTotalLabel {
        background-color: #666;
        color: #fff;
        font-weight: bold;
        font-size: 13px;
    }
    .grandTotalValue {
        background-color: #666;
        color: #fff;
        font-weight: bold;
        font-size: 13px;
        text-align: right;
    }

    .commentsBlock {
        border: 1px solid #999;
        border-collapse: collapse;
        width: 100%;
        margin-top: 14px;
    }
    .commentsBlock td {
        border: 1px solid #ccc;
        padding: 4px 6px;
        vertical-align: top;
        font-size: 11px;
    }

    @page {
        size: portrait;
        margin: 0.25in;

        @bottom-left {
            white-space: nowrap;
            font-size: 10px;
            content: "RO#:&nbsp; <apex:outputText value="{!ro.dealer__RO_Number__c}"/>";
        }
        @bottom-center {
            white-space: nowrap;
            font-size: 10px;
            content: "Printed By:&nbsp; <apex:outputText value="{!printedByName}"/>&nbsp;&#8212;&nbsp;<apex:outputText value="{!printDateTime}"/>";
        }
        @bottom-right {
            white-space: nowrap;
            font-size: 10px;
            content: "Page " counter(page) " of " counter(pages);
        }
    }

    .page-number:before { content: counter(page); }
    .page-count:before { content: counter(pages); }
    .pageFooter {
        position: fixed;
        bottom: 0;
        width: 100%;
        font-size: 10px;
        padding: 5px;
        text-align: center;
    }
</style>
</head>

<body>

<!-- Header -->
<table cellpadding="0" cellspacing="0" class="headerBlock">
    <tr>
        <td colspan="3" class="headerTitle">Service Repair Order - Warranty Copy</td>
    </tr>
    <tr>
        <td align="left" valign="top" class="bRight" style="width:110px; padding:4px;">
            <apex:outputPanel layout="none" rendered="{!hasLogo}">
                <apex:image id="businessLogo" url="{!logoUrl}" style="height: 80px; width: auto;" alt="Company Logo" />
            </apex:outputPanel>
            <apex:outputPanel layout="none" rendered="{!hasServiceHours}">
                <div class="serviceHours">
                    <div class="serviceHoursTitle">Service Hours</div>
                    <apex:repeat value="{!serviceHoursLines}" var="shLine">
                        <div><apex:outputText value="{!shLine}" /></div>
                    </apex:repeat>
                </div>
            </apex:outputPanel>
        </td>
        <td valign="top">
            <div id="orgDetails">
                <apex:outputPanel layout="none" rendered="{!ISBLANK(userLoc.Name)}">
                    <span class="dealerName"><apex:outputText value="{!$Organization.Name}" /></span><br />
                    <apex:outputText value="{!$Organization.Street}" /><br />
                    <apex:outputText value="{!$Organization.City}" />,&nbsp;<apex:outputText value="{!$Organization.State}" />&nbsp;<apex:outputText value="{!$Organization.PostalCode}" />
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(userLoc.Name))}">
                    <span class="dealerName"><apex:outputText value="{!userLoc.Name}" /></span><br />
                    <apex:outputText value="{!userLoc.dealer__Street__c}" /><br />
                    <apex:outputText value="{!userLoc.dealer__City__c}" />,&nbsp;<apex:outputText value="{!userLoc.dealer__State__c}" />&nbsp;<apex:outputText value="{!userLoc.dealer__Postal_Code__c}" /><br />
                    <apex:outputText value="{!userLoc.dealer__Website__c}" />
                    <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(userLoc.dealer__BAR_Number__c))}">
                        <br /><span class="cGrey">{!$ObjectType.dealer__Dealer_Location__c.Fields.dealer__BAR_Number__c.Label}:</span>&nbsp;<apex:outputText value="{!userLoc.dealer__BAR_Number__c}" />
                    </apex:outputPanel>
                    <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(userLoc.dealer__EPA_Number__c))}">
                        <br /><span class="cGrey">{!$ObjectType.dealer__Dealer_Location__c.Fields.dealer__EPA_Number__c.Label}:</span>&nbsp;<apex:outputText value="{!userLoc.dealer__EPA_Number__c}" />
                    </apex:outputPanel>
                    <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(userLoc.dealer__Main_Phone__c))}">
                        <br /><span class="cGrey">Service Phone:</span>&nbsp;<apex:outputText value="{!userLoc.dealer__Main_Phone__c}" />
                    </apex:outputPanel>
                </apex:outputPanel>
            </div>
        </td>
        <td valign="top" class="bLeft" style="width:42%;">
            <table cellpadding="0" cellspacing="0" class="infoTable">
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__RO_Number__c.Label}</td>
                    <td class="infoValueBold"><apex:outputText value="{!ro.dealer__RO_Number__c}" /></td>
                </tr>
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.CreatedDate.Label}</td>
                    <td>
                        <apex:outputText value="{0,date,MM/dd/yyyy}" rendered="{!NOT(ISBLANK(ro.CreatedDate))}">
                            <apex:param value="{!ro.CreatedDate}" />
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Invoiced_Date_Time__c.Label}</td>
                    <td>
                        <apex:outputText value="{0,date,MM/dd/yyyy}" rendered="{!NOT(ISBLANK(ro.dealer__Invoiced_Date_Time__c))}">
                            <apex:param value="{!ro.dealer__Invoiced_Date_Time__c}" />
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Posted_Date_Time__c.Label}</td>
                    <td>
                        <apex:outputText value="{0,date,MM/dd/yyyy}" rendered="{!NOT(ISBLANK(ro.dealer__Posted_Date_Time__c))}">
                            <apex:param value="{!ro.dealer__Posted_Date_Time__c}" />
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Status__c.Label}</td>
                    <td><apex:outputText value="{!ro.dealer__Status__c}" /></td>
                </tr>
                <tr class="amountRow">
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Charges__c.Label}</td>
                    <td class="alignRight">
                        <apex:outputText value="{!currencyCode}" /><apex:outputText value="{0,number, #,###,##0.00}">
                            <apex:param value="{!warrantyCharges}" />
                        </apex:outputText>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td colspan="3" class="sectionHeader bTop" style="font-size:12px; padding:3px 6px;">Customer</td>
    </tr>
    <tr>
        <td valign="top" colspan="2">
            <div id="customerNameBlock">
                <div id="CustomerName" style="font-weight:bold;"><apex:outputText value="{!customerName}" /></div>
                <apex:outputText value="{!customerStreet}" /><br />
                <apex:outputText value="{!customerCity}" /><apex:outputText rendered="{!NOT(ISBLANK(customerCity))}">,</apex:outputText>&nbsp;
                <apex:outputText value="{!customerState}" />&nbsp;
                <apex:outputText value="{!customerPostalCode}" />
            </div>
        </td>
        <td valign="top" class="bLeft">
            <table cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
                <tr>
                    <td class="contactLabel">Account #</td>
                    <td class="contactValue"><apex:outputText value="{!customerAccountNumber}" /></td>
                </tr>
                <tr>
                    <td class="contactLabel">Phone</td>
                    <td class="contactValue"><apex:outputText value="{!customerPhone}" /></td>
                </tr>
                <tr>
                    <td class="contactLabel">Mobile</td>
                    <td class="contactValue"><apex:outputText value="{!customerMobile}" /></td>
                </tr>
                <tr>
                    <td class="contactLabel">Email</td>
                    <td class="contactValue"><apex:outputText value="{!customerEmail}" /></td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td colspan="3" class="sectionHeader bTop" style="font-size:12px; padding:3px 6px;">Vehicle</td>
    </tr>
    <tr>
        <td colspan="3" style="padding:0;">
            <table cellpadding="0" cellspacing="0" class="infoTable vehicleTable" width="100%">
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Vehicle__c.Fields.dealer__Year__c.Label}</td>
                    <td><apex:outputText value="{!ro.dealer__Vehicle__r.dealer__Year__c}" /></td>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Vehicle__c.Fields.dealer__Make__c.Label}</td>
                    <td><apex:outputText value="{!ro.dealer__Vehicle__r.dealer__Make__c}" /></td>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Vehicle__c.Fields.dealer__Carline__c.Label}</td>
                    <td><apex:outputText value="{!ro.dealer__Vehicle__r.dealer__Carline__c}" /></td>
                </tr>
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Vehicle__c.Fields.dealer__VIN__c.Label}</td>
                    <td colspan="3"><apex:outputText value="{!ro.dealer__Vehicle__r.dealer__VIN__c}" /></td>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Vehicle__c.Fields.dealer__Licence__c.Label}</td>
                    <td><apex:outputText value="{!ro.dealer__Vehicle__r.dealer__Licence__c}" /></td>
                </tr>
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Mileage_In__c.Label}</td>
                    <td>
                        <apex:outputText value="{0, number, #,###,###}">
                            <apex:param value="{!ro.dealer__Mileage_In__c}" />
                        </apex:outputText>
                    </td>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Mileage_Out__c.Label}</td>
                    <td>
                        <apex:outputText value="{0, number, #,###,###}">
                            <apex:param value="{!ro.dealer__Mileage_Out__c}" />
                        </apex:outputText>
                    </td>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Service_Advisor__c.Label}</td>
                    <td><apex:outputText value="{!ro.dealer__Service_Advisor__r.Name}" /></td>
                </tr>
                <tr>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Vehicle__c.Fields.dealer__Sale_Date__c.Label}</td>
                    <td>
                        <apex:outputText value="{0, date, MM/dd/yyyy}" rendered="{!NOT(ISBLANK(ro.dealer__Vehicle__r.dealer__Sale_Date__c))}">
                            <apex:param value="{!ro.dealer__Vehicle__r.dealer__Sale_Date__c}" />
                        </apex:outputText>
                    </td>
                    <td class="infoLabel">{!$ObjectType.dealer__Service_Vehicle__c.Fields.dealer__Licence__c.Label}</td>
                    <td colspan="3"><apex:outputText value="{!ro.dealer__Vehicle__r.dealer__Licence__c}" /></td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<!-- Warranty Company -->
<apex:outputPanel layout="none" rendered="{!OR(hasWarrantyAccount, NOT(ISBLANK(warrantyAuth)), warrantyDeductible != 0, hasWarrantyComments)}">
<table cellpadding="0" cellspacing="0" class="headerBlock">
    <tr>
        <td colspan="2" class="sectionHeader" style="font-size:12px; padding:3px 6px;">Warranty Company</td>
    </tr>
    <tr>
        <td valign="top" style="width:58%;">
            <div id="warrantyCompanyBlock">
                <div style="font-weight:bold;"><apex:outputText value="{!warrantyCompanyName}" /></div>
                <apex:outputText value="{!warrantyCompanyStreet}" /><apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(warrantyCompanyStreet))}"><br /></apex:outputPanel>
                <apex:outputText value="{!warrantyCompanyCity}" /><apex:outputText rendered="{!NOT(ISBLANK(warrantyCompanyCity))}">,</apex:outputText>&nbsp;
                <apex:outputText value="{!warrantyCompanyState}" />&nbsp;
                <apex:outputText value="{!warrantyCompanyPostalCode}" />
                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(warrantyCompanyPhone))}">
                    <br /><span class="cGrey">Phone:</span>&nbsp;<apex:outputText value="{!warrantyCompanyPhone}" />
                </apex:outputPanel>
            </div>
        </td>
        <td valign="top" class="bLeft">
            <table cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
                <tr>
                    <td class="contactLabel" style="width:90px;">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Auth__c.Label}</td>
                    <td class="contactValue"><apex:outputText value="{!warrantyAuth}" /></td>
                </tr>
                <tr>
                    <td class="contactLabel" style="width:90px;">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Deductible__c.Label}</td>
                    <td class="contactValue">
                        <apex:outputText value="{!currencyCode}" /><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!warrantyDeductible}" /></apex:outputText>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <apex:outputPanel layout="none" rendered="{!hasWarrantyComments}">
        <tr>
            <td colspan="2" class="bTop">
                <span class="cGrey" style="font-weight:bold;">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Comments__c.Label}:</span>&nbsp;
                <apex:outputText value="{!warrantyComments}" />
            </td>
        </tr>
    </apex:outputPanel>
</table>
</apex:outputPanel>

<!-- Service Contracts -->
<apex:outputPanel layout="none" rendered="{!hasServiceContracts}">
<table cellpadding="0" cellspacing="0" class="headerBlock">
    <tr>
        <td class="sectionHeader" style="font-size:12px; padding:3px 6px;">Service Contracts</td>
    </tr>
    <tr>
        <td style="padding:0;">
            <table cellpadding="0" cellspacing="0" class="infoTable vehicleTable" width="100%">
                <tr>
                    <td class="infoLabel" style="width:auto;">{!$ObjectType.dealer__Service_Contract__c.Fields.dealer__Type__c.Label}</td>
                    <td class="infoLabel" style="width:auto;">{!$ObjectType.dealer__Service_Contract__c.Fields.dealer__Description__c.Label}</td>
                    <td class="infoLabel alignRight" style="width:auto;">{!$ObjectType.dealer__Service_Contract__c.Fields.dealer__Deductable__c.Label}</td>
                    <td class="infoLabel alignRight" style="width:auto;">{!$ObjectType.dealer__Service_Contract__c.Fields.dealer__Expiration_Months__c.Label}</td>
                    <td class="infoLabel alignRight" style="width:auto;">{!$ObjectType.dealer__Service_Contract__c.Fields.dealer__Expiration_Mileage__c.Label}</td>
                    <td class="infoLabel alignRight" style="width:auto;">{!$ObjectType.dealer__Service_Contract__c.Fields.dealer__End_Date__c.Label}</td>
                </tr>
                <apex:repeat value="{!serviceContracts}" var="sc">
                    <tr>
                        <td><apex:outputText value="{!sc.dealer__Type__c}" /></td>
                        <td><apex:outputText value="{!sc.dealer__Description__c}" /></td>
                        <td class="alignRight">
                            <apex:outputText rendered="{!NOT(ISBLANK(sc.dealer__Deductable__c))}"><apex:outputText value="{!currencyCode}" /><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!sc.dealer__Deductable__c}" /></apex:outputText></apex:outputText>
                        </td>
                        <td class="alignRight">
                            <apex:outputText value="{0, number, #,###,##0}"><apex:param value="{!sc.dealer__Expiration_Months__c}" /></apex:outputText>
                        </td>
                        <td class="alignRight">
                            <apex:outputText value="{0, number, #,###,##0}"><apex:param value="{!sc.dealer__Expiration_Mileage__c}" /></apex:outputText>
                        </td>
                        <td class="alignRight">
                            <apex:outputText value="{0, date, MM/dd/yyyy}" rendered="{!NOT(ISBLANK(sc.dealer__End_Date__c))}"><apex:param value="{!sc.dealer__End_Date__c}" /></apex:outputText>
                        </td>
                    </tr>
                </apex:repeat>
            </table>
        </td>
    </tr>
</table>
</apex:outputPanel>

<div style="height: 4px"></div>
<div class="sectionHeader" style="margin-bottom:4px; padding:3px 6px; font-size:12px;"><b>Description of Service</b></div>

<!-- Job Lines -->
<apex:repeat value="{!jobs}" var="j">
    <table cellpadding="0" cellspacing="0" class="job-line-block">
        <colgroup>
            <col />
            <col style="width:95px;" />
            <col style="width:95px;" />
        </colgroup>
        <!-- Job header -->
        <tr class="jobHeader">
            <td colspan="2">
                Job#&nbsp;<apex:outputText value="{0, number, ###,##0}"><apex:param value="{!j.lineNumber}" /></apex:outputText>&nbsp;
                <apex:outputText value="{!j.opCode}" />
            </td>
            <td class="alignRight"><apex:outputText value="{!j.laborType}" /></td>
        </tr>

        <!-- Concern / Cause / Correction -->
        <tr>
            <td colspan="3"><span class="jobDescLabel">Concern:</span>&nbsp;<apex:outputText escape="true" value="{!j.customerConcern}" /></td>
        </tr>
        <apex:outputPanel layout="none" rendered="{!j.hasCause}">
            <tr>
                <td colspan="3"><span class="jobDescLabel">Cause:</span>&nbsp;<apex:outputText escape="true" value="{!j.causeExtended}" /></td>
            </tr>
        </apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!j.hasCorrection}">
            <tr>
                <td colspan="3"><span class="jobDescLabel">Correction:</span>&nbsp;<apex:outputText escape="true" value="{!j.correction}" /></td>
            </tr>
        </apex:outputPanel>

        <!-- Column headers (Cost / Price) -->
        <tr class="colHeadRow">
            <td>&#160;</td>
            <td>{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Cost__c.Label}</td>
            <td>{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Price__c.Label}</td>
        </tr>

        <!-- Labor subtotal -->
        <tr class="subtotalRow">
            <td class="subtotalLabel">{!$ObjectType.dealer__Service_Job__c.Fields.dealer__Labor_Charges__c.Label}</td>
            <td class="alignRight">
                <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.laborCost}" /></apex:outputText>
            </td>
            <td class="alignRight">
                <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.laborSale}" /></apex:outputText>
            </td>
        </tr>

        <!-- Parts -->
        <apex:outputPanel layout="none" rendered="{!j.hasParts}">
            <tr>
                <td colspan="3" style="padding:0;">
                    <table cellpadding="0" cellspacing="0" class="detailTable">
                        <tr>
                            <th style="width:7%;">{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Quantity_Sold__c.Label}</th>
                            <th style="width:18%;">{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Part_Number__c.Label}</th>
                            <th style="width:39%;">{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Part_Description__c.Label}</th>
                            <th style="width:12%;" class="alignRight">{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Price__c.Label}</th>
                            <th style="width:12%;" class="alignRight">{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Extended_Cost__c.Label}</th>
                            <th style="width:12%;" class="alignRight">{!$ObjectType.dealer__Parts_Invoice_Line__c.Fields.dealer__Extended_Price__c.Label}</th>
                        </tr>
                        <apex:repeat value="{!j.parts}" var="p">
                            <tr>
                                <td><apex:outputText value="{0, number, ###,##0}"><apex:param value="{!p.quantitySold}" /></apex:outputText></td>
                                <td><apex:outputText value="{!p.partNumber}" /></td>
                                <td><apex:outputText value="{!p.partDescription}" /></td>
                                <td class="alignRight"><apex:outputText value="{0, number, ###,##0.00}"><apex:param value="{!p.unitPrice}" /></apex:outputText></td>
                                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!p.extendedCost}" /></apex:outputText></td>
                                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!p.extendedPrice}" /></apex:outputText></td>
                            </tr>
                        </apex:repeat>
                        <apex:repeat value="{!j.serialNumbers}" var="sn">
                            <tr>
                                <td></td>
                                <td></td>
                                <td colspan="4" class="cGreyI">{!$ObjectType.dealer__Parts_Ledger__c.Fields.dealer__SerialNumber__c.Label}: <apex:outputText value="{!sn}" /></td>
                            </tr>
                        </apex:repeat>
                    </table>
                </td>
            </tr>
            <tr class="subtotalRow">
                <td class="subtotalLabel">{!$ObjectType.dealer__Service_Job__c.Fields.dealer__Parts_Total__c.Label}</td>
                <td class="alignRight">
                    <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.partsCost}" /></apex:outputText>
                </td>
                <td class="alignRight">
                    <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.partsSale}" /></apex:outputText>
                </td>
            </tr>
        </apex:outputPanel>

        <!-- Miscellaneous -->
        <apex:outputPanel layout="none" rendered="{!j.hasMisc}">
            <tr>
                <td colspan="3" style="padding:0;">
                    <table cellpadding="0" cellspacing="0" class="detailTable">
                        <tr>
                            <th style="width:25%;">{!$ObjectType.dealer__Service_Misc_Charge__c.Fields.dealer__MiscChargeCode__c.Label}</th>
                            <th style="width:51%;">{!$ObjectType.dealer__Service_Misc_Charge__c.Fields.dealer__Description__c.Label}</th>
                            <th style="width:12%;" class="alignRight">{!$ObjectType.dealer__Service_Misc_Charge__c.Fields.dealer__Cost__c.Label}</th>
                            <th style="width:12%;" class="alignRight">{!$ObjectType.dealer__Service_Misc_Charge__c.Fields.dealer__Amount__c.Label}</th>
                        </tr>
                        <apex:repeat value="{!j.miscCharges}" var="m">
                            <tr>
                                <td><apex:outputText value="{!m.code}" /></td>
                                <td><apex:outputText value="{!m.description}" /></td>
                                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!m.cost}" /></apex:outputText></td>
                                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!m.amount}" /></apex:outputText></td>
                            </tr>
                        </apex:repeat>
                    </table>
                </td>
            </tr>
            <tr class="subtotalRow">
                <td class="subtotalLabel">{!$ObjectType.dealer__Service_Job__c.Fields.dealer__Misc_Charges__c.Label}</td>
                <td class="alignRight">
                    <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.miscCost}" /></apex:outputText>
                </td>
                <td class="alignRight">
                    <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.miscSale}" /></apex:outputText>
                </td>
            </tr>
        </apex:outputPanel>

        <!-- Sublet -->
        <apex:outputPanel layout="none" rendered="{!j.hasSublet}">
            <tr>
                <td colspan="3" style="padding:0;">
                    <table cellpadding="0" cellspacing="0" class="detailTable">
                        <tr>
                            <th style="width:18%;">{!$ObjectType.dealer__Purchase_Order_Line__c.Fields.dealer__Purchase_Order__c.Label}</th>
                            <th style="width:28%;">{!$ObjectType.dealer__Purchase_Order__c.Fields.dealer__Vendor_Name__c.Label}</th>
                            <th style="width:30%;">{!$ObjectType.dealer__Purchase_Order_Line__c.Fields.dealer__Description__c.Label}</th>
                            <th style="width:12%;" class="alignRight">{!$ObjectType.dealer__Purchase_Order_Line__c.Fields.dealer__Cost__c.Label}</th>
                            <th style="width:12%;" class="alignRight">{!$ObjectType.dealer__Purchase_Order_Line__c.Fields.dealer__Customer_Total__c.Label}</th>
                        </tr>
                        <apex:repeat value="{!j.sublets}" var="s">
                            <tr>
                                <td><apex:outputText value="{!s.poNumber}" /></td>
                                <td><apex:outputText value="{!s.vendorName}" /></td>
                                <td><apex:outputText value="{!s.description}" /></td>
                                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!s.cost}" /></apex:outputText></td>
                                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!s.price}" /></apex:outputText></td>
                            </tr>
                        </apex:repeat>
                    </table>
                </td>
            </tr>
            <tr class="subtotalRow">
                <td class="subtotalLabel">{!$ObjectType.dealer__Service_Job__c.Fields.dealer__Sublet_Total__c.Label}</td>
                <td class="alignRight">
                    <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.subletCost}" /></apex:outputText>
                </td>
                <td class="alignRight">
                    <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.subletSale}" /></apex:outputText>
                </td>
            </tr>
        </apex:outputPanel>

        <!-- Line total -->
        <tr class="lineTotalRow">
            <td>{!$ObjectType.dealer__Service_Job__c.Fields.dealer__Line_Total__c.Label}</td>
            <td class="alignRight">
                <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.lineCost}" /></apex:outputText>
            </td>
            <td class="alignRight">
                <apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!j.lineSale}" /></apex:outputText>
            </td>
        </tr>
    </table>
</apex:repeat>

<!-- Disclaimer + Totals -->
<table cellpadding="0" cellspacing="0" class="summaryWrapper">
    <tr>
        <td width="55%" valign="top" class="disclaimerCell">
            <apex:outputPanel layout="none" rendered="{!ISBLANK(userLoc.dealer__Service_RO_Disclaimer__c)}">
                <b>TERMS: STRICTLY CASH UNLESS ARRANGEMENTS ARE MADE.</b> "I hereby authorize the repair work hereinafter
                to be done along with the necessary material and agree that you are not responsible for loss
                or damage to vehicle or articles left in the vehicle in case of fire, theft, or any other cause
                beyond your control or for any delays caused by unavailability of parts or delays in parts shipments
                by the supplier or transporter. I hereby grant you or your employees permission to operate the
                vehicle herein described on streets, highways, or elsewhere for the purpose of testing and/or
                inspection. An express mechanic's lien is hereby acknowledged on above vehicle to secure the
                amount of repairs thereto."
                <br /><br />
                DISCLAIMER OF WARRANTIES. Any warranties on the products sold hereby are those made by the manufacturer.
                The seller hereby expressly disclaims all warranties either express or implied, including any
                implied warranty of merchantability or fitness for a particular purpose, and the seller neither
                assumes nor authorizes any other person to assume for it any liability in connection with the
                sale of said products. Any limitation contained herein does not apply where prohibited by law.
                <div class="noticeBar">NO RETURN ON ELECTRICAL OR SAFETY ITEMS OR SPECIAL ORDERS</div>
            </apex:outputPanel>
            <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(userLoc.dealer__Service_RO_Disclaimer__c))}">
                <apex:outputField value="{!userLoc.dealer__Service_RO_Disclaimer__c}" />
            </apex:outputPanel>

            <div class="signatureLine">
                <span class="bigX">X</span>&#160;
                <span style="border-bottom:1px solid #000000; display:inline-block; min-width:18em; vertical-align:baseline;"><apex:outputText value="\s1\" style="color:#ffffff; font-size:7pt;" /></span>
                <span>&#160;Owner or Authorized Representative</span>
            </div>
        </td>
        <td width="45%" valign="top">
            <table cellpadding="0" cellspacing="0" class="totalsTable">
                <tr>
                    <td class="totalsLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Labor_Charges__c.Label}</td>
                    <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalLabor}" /></apex:outputText></td>
                </tr>
                <tr>
                    <td class="totalsLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Parts_Charges__c.Label}</td>
                    <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalParts}" /></apex:outputText></td>
                </tr>
                <tr>
                    <td class="totalsLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Misc_Charges__c.Label}</td>
                    <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalMisc}" /></apex:outputText></td>
                </tr>
                <tr>
                    <td class="totalsLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__WarrantySubletCharges__c.Label}</td>
                    <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalSublet}" /></apex:outputText></td>
                </tr>
                <apex:outputPanel layout="none" rendered="{!warrantyDeductible != 0}">
                    <tr>
                        <td class="totalsLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Deductible__c.Label}</td>
                        <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!warrantyDeductible}" /></apex:outputText></td>
                    </tr>
                </apex:outputPanel>
                <tr>
                    <td class="grandTotalLabel">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Warranty_Charges__c.Label}</td>
                    <td class="grandTotalValue">
                        <apex:outputText value="{!currencyCode}" /><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!warrantyCharges}" /></apex:outputText>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<!-- Comments -->
<apex:outputPanel layout="none" rendered="{!hasComments}">
    <table cellpadding="0" cellspacing="0" class="commentsBlock">
        <tr>
            <td class="infoLabel" style="width:90px;">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Comments__c.Label}</td>
            <td><apex:outputText value="{!ro.dealer__Comments__c}" /></td>
        </tr>
    </table>
</apex:outputPanel>

<!-- Footer (HTML preview only; PDF uses @page footer) -->
<apex:outputPanel layout="none" rendered="{!NOT(isPdf)}">
    <div class="pageFooter">
        RO#: {!ro.dealer__RO_Number__c} &#8212; Printed By: {!printedByName} &#8212; {!printDateTime}
    </div>
</apex:outputPanel>

</body>
</apex:page>
