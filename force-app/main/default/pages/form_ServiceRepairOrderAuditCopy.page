            </tr>
            <tr>
                <td class="totalsLabel">Sublet</td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalSubletCost}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalSubletSale}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalSubletSale - totalSubletCost}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,##0.0}"><apex:param value="{!subletGrossPercent}" /></apex:outputText>%</td>
            </tr>
            <tr>
                <td class="grandTotalLabel">Total</td>
                <td class="grandTotalValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalCost}" /></apex:outputText></td>
                <td class="grandTotalValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalSale}" /></apex:outputText></td>
                <td class="grandTotalValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalGross}" /></apex:outputText></td>
                <td class="grandTotalValue"><apex:outputText value="{0, number, #,##0.0}"><apex:param value="{!grossPercent}" /></apex:outputText>%</td>
            </tr>
        </table>
    </div>

    <apex:repeat value="{!grossByPayType}" var="gp">
        <apex:outputPanel layout="none" rendered="{!gp.hasData}">
            <div class="summaryBlock" style="width:70%; margin-top:14px;">
