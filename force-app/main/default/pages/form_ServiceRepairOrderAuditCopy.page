                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!internalMisc}" /></apex:outputText></td>
            </tr>
            <tr>
                <td class="totalsLabel">Sublet</td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!customerSublet}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!warrantySublet}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!internalSublet}" /></apex:outputText></td>
