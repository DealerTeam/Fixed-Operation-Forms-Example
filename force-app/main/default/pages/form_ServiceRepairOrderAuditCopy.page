                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalLaborSale}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalLaborSale - totalLaborCost}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,##0.0}"><apex:param value="{!laborGrossPercent}" /></apex:outputText>%</td>
            </tr>
            <tr>
                <td class="totalsLabel">Parts</td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalPartsCost}" /></apex:outputText></td>
                <td class="totalsValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalPartsSale}" /></apex:outputText></td>
