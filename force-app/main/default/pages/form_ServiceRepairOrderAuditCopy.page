                    <apex:outputText value="{!currencyCode}" /><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!customerInvoiceTotal}" /></apex:outputText>
                </td>
            </tr>
        </table>
    </div>

    <div class="summaryBlock" style="width:70%; margin-top:14px;">
