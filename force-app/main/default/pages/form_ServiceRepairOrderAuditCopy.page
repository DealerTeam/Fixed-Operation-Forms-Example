<!-- Payments -->
<apex:outputPanel layout="none" rendered="{!hasPayments}">
    <table cellpadding="0" cellspacing="0" class="paymentsTable">
        <tr>
            <th>{!$ObjectType.dealer__Cashering__c.Fields.dealer__Payment_Type__c.Label}</th>
            <th class="alignCenter">{!$ObjectType.dealer__Cashering__c.Fields.dealer__Deposit__c.Label}</th>
            <th>{!$ObjectType.dealer__Cashering__c.Fields.dealer__Close_Date__c.Label}</th>
            <th class="alignRight">{!$ObjectType.dealer__Cashering__c.Fields.dealer__Amount__c.Label}</th>
            <th class="alignRight">{!$ObjectType.dealer__Cashering__c.Fields.dealer__ProcessingFee__c.Label}</th>
            <th class="alignRight">Payment Total</th>
        </tr>
        <apex:variable var="payIdx" value="{!0}" />
        <apex:repeat value="{!cashLines}" var="c">
            <tr class="{!IF(MOD(payIdx, 2) == 0, 'evenRow', 'oddRow')}">
                <td><apex:outputText value="{!c.paymentMethod}" /></td>
                <td class="alignCenter"><apex:outputText value="Yes" rendered="{!c.isDeposit}" /></td>
                <td><apex:outputText value="{0, date, MM/dd/yyyy}"><apex:param value="{!c.closeDate}" /></apex:outputText></td>
                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!c.amount}" /></apex:outputText></td>
                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!c.processingFee}" /></apex:outputText></td>
                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!c.lineTotal}" /></apex:outputText></td>
            </tr>
            <apex:variable var="payIdx" value="{!payIdx + 1}" />
        </apex:repeat>
        <tr>
            <td colspan="4">&#160;</td>
            <td class="alignRight" style="font-weight:bold;">Total Paid:</td>
            <td class="alignRight" style="font-weight:bold;">
                <apex:outputText value="{!currencyCode}" /><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!totalPaid}" /></apex:outputText>
            </td>
        </tr>
    </table>
</apex:outputPanel>

