                <td class="grandTotalValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!warrantyCharges}" /></apex:outputText></td>
                <td class="grandTotalValue"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!internalCharges}" /></apex:outputText></td>
            </tr>
            <apex:outputPanel layout="none" rendered="{!hasDiscount}">
