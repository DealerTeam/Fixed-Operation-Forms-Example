            <th style="width:24%;">{!$ObjectType.dealer__GLDetail__x.Fields.dealer__AccountName__c.Label}</th>
            <th style="width:24%;">{!$ObjectType.dealer__GLDetail__x.Fields.dealer__PostingDescription__c.Label}</th>
            <th style="width:11%;">{!$ObjectType.dealer__GLDetail__x.Fields.dealer__ControlNumber__c.Label}</th>
            <th style="width:9%;">{!$ObjectType.dealer__GLDetail__x.Fields.dealer__SaleType__c.Label}</th>
            <th style="width:10%;">{!$ObjectType.dealer__GLDetail__x.Fields.dealer__AccountingDate__c.Label}</th>
            <th style="width:10%;" class="alignRight">{!$ObjectType.dealer__GLDetail__x.Fields.dealer__Amount__c.Label}</th>
        </tr>
        <apex:variable var="glIdx" value="{!0}" />
        <apex:repeat value="{!glLines}" var="g">
            <tr class="{!IF(MOD(glIdx, 2) == 0, 'evenRow', 'oddRow')}">
                <td><apex:outputText value="{!g.account}" /></td>
                <td><apex:outputText value="{!g.accountName}" /></td>
                <td><apex:outputText value="{!g.postingDescription}" /></td>
                <td><apex:outputText value="{!g.controlNumber}" /></td>
                <td><apex:outputText value="{!g.saleType}" /></td>
                <td>
                    <apex:outputText value="{0, date, MM/dd/yyyy}" rendered="{!NOT(ISBLANK(g.accountingDate))}"><apex:param value="{!g.accountingDate}" /></apex:outputText>
                </td>
                <td class="alignRight"><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!g.amount}" /></apex:outputText></td>
            </tr>
            <apex:variable var="glIdx" value="{!glIdx + 1}" />
        </apex:repeat>
        <tr class="glTotalRow">
            <td colspan="6" class="alignRight">Net Posted:</td>
            <td class="alignRight">
                <apex:outputText value="{!currencyCode}" /><apex:outputText value="{0, number, #,###,##0.00}"><apex:param value="{!glTotal}" /></apex:outputText>
            </td>
        </tr>
    </table>
</apex:outputPanel>

<!-- Comments -->
<apex:outputPanel layout="none" rendered="{!hasComments}">
    <table cellpadding="0" cellspacing="0" class="commentsBlock">
        <tr>
            <td class="infoLabel" style="width:90px;">{!$ObjectType.dealer__Service_Repair_Order__c.Fields.dealer__Comments__c.Label}</td>
            <td><apex:outputText value="{!ro.dealer__Comments__c}" /></td>
        </tr>
    </table>
</apex:outputPanel>

<!-- Footer (HTML preview only; PDF uses @page footer) -->
<apex:outputPanel layout="none" rendered="{!NOT(isPdf)}">
    <div class="pageFooter">
        RO#: {!ro.dealer__RO_Number__c} &#8212; Printed By: {!printedByName} &#8212; {!printDateTime}
    </div>
</apex:outputPanel>

</body>
</apex:page>
